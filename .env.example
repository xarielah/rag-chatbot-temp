ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
QDRANT_URL=https://xxxx.cloud.qdrant.io:6333
QDRANT_API_KEY=

# --- chat persistence (all optional; defaults shown) ---
# CHAT_TTL_DAYS=30
# CHAT_HISTORY_LIMIT=50
# CHAT_TOKEN_BUDGET=50000
# CHAT_SUMMARY_EVERY_TURNS=10
# CHAT_SUMMARY_MAX_TOKENS=400

# --- auth / database ---
POSTGRES_PASSWORD=change-me
# Optional: cloud Postgres (Neon, Supabase, RDS...). Leave unset to use the local container.
# postgres:// and postgresql:// are both accepted; most clouds need sslmode=require
# DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -hex 32
SESSION_SECRET=
# Comma-separated; seeded into the allow-list as admins on startup
INITIAL_ADMIN_EMAILS=you@example.com
# false for plain-http local dev
COOKIE_SECURE=true
# Optional: pin the callback URL (must match the Google console), e.g. http://localhost:5173/api/auth/callback
GOOGLE_REDIRECT_URI=
# Where to land after login (frontend origin/path)
FRONTEND_URL=/
